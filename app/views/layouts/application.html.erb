<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Stock Dashboard</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- External UI Libraries -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="https://unpkg.com/lightweight-charts@4.2.0/dist/lightweight-charts.standalone.production.js" defer></script>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  
  <body class="bg-light d-flex flex-column min-vh-100">
    <!-- Application Header -->
    <header class="text-white py-3 mb-4 shadow-sm" style="background: linear-gradient(90deg, #0d3b66, #14538f);">
      <div class="container d-flex align-items-center">
        
        <!-- Clickable Logo with Hard Reload -->
        <%= link_to root_path, class: "text-decoration-none text-white d-flex align-items-center gap-3", data: { turbo: false } do %>
          <%= image_tag "logo.png", alt: "Stock Dashboard Logo", width: 60, height: 60, class: "me-1" %>
          <h1 class="h4 mb-0 fw-semibold">Stock Dashboard</h1>
        <% end %>

      </div>
    </header>

    <!-- Main Dynamic Content -->
    <main class="flex-grow-1 container">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="text-center text-muted small py-4">
      Market data by Yahoo Finance &middot; Educational use only.
    </footer>
  </body>
</html>