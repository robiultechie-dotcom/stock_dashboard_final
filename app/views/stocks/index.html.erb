<div id="stock-dashboard" class="container pb-5">
  
  <!-- Error Alert Container -->
  <div id="dashboard-alert" class="alert alert-danger d-none" role="alert"></div>
  
  <!-- Search Section -->
  <section class="card border-0 shadow-sm mb-4">
    <div class="card-body">
      <label for="stock-search" class="form-label fw-semibold">Search stocks</label>
      <div class="position-relative">
        <input id="stock-search" type="text" class="form-control form-control-lg" placeholder="Type a company or ticker (e.g. AAPL, MSFT)" autocomplete="off">
        <ul id="suggestions" class="list-group position-absolute w-100 d-none" style="z-index: 1050; max-height: 320px; overflow-y: auto; margin-top: 2px; box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15);"></ul>
        <div id="search-status" class="d-none position-absolute w-100 bg-white border rounded p-2 mt-1 shadow-sm" style="z-index: 1049;"></div>
      </div>
    </div>
  </section>

  <!-- Empty State (Shown before selection) -->
  <section id="empty-state" class="text-center py-5">
    <div class="display-4 mb-3" aria-hidden="true">🔎</div>
    <h2 class="h5 text-muted">Search above to view a stock chart</h2>
  </section>

  <!-- Selected Stock Summary -->
  <section id="stock-summary" class="d-none mb-4">
    <div class="card border-0 shadow-sm">
      <div class="card-body d-flex flex-wrap align-items-baseline gap-2 gap-md-3">
        <h2 class="h4 mb-0">
          <span id="summary-symbol" class="fw-bold"></span>
          <span id="summary-name" class="text-muted h6 ms-1"></span>
        </h2>
        <div class="ms-auto text-end">
          <div id="summary-price" class="h4 mb-0 fw-bold"></div>
          <div id="summary-change" class="fw-semibold small"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Chart & Controls -->
  <section id="chart-card" class="card border-0 shadow-sm d-none">
    <div class="card-header bg-white d-flex align-items-center gap-2">
      <span class="fw-semibold me-auto">Price history</span>
      <div class="btn-group btn-group-sm">
        <% %w[1D 5D 1W 1M 1Y].each do |r| %>
          <button type="button" class="btn btn-outline-primary range-btn <%= "active" if r == "1M" %>" data-range="<%= r %>"><%= r %></button>
        <% end %>
      </div>
    </div>
    <div class="card-body position-relative p-2 p-md-3" style="height: 420px;">
      <div id="stock-chart" style="width: 100%; height: 100%;"></div>
      <div id="chart-loading" class="position-absolute w-100 h-100 top-0 start-0 d-flex align-items-center justify-content-center bg-white bg-opacity-75 d-none" style="z-index: 10;">
        <div class="spinner-border text-primary"></div>
      </div>
    </div>
  </section>
</div>